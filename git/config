[user]
	name = Lewis Blackburn

[include]
	# Email and anything work-specific; kept out of the repo.
	path = ~/.config/git/local.gitconfig

[core]
	pager = delta
	excludesfile = ~/.config/git/ignore

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

[init]
	defaultBranch = main

[pull]
	ff = only

[fetch]
	prune = true

[rebase]
	autosquash = true
	autostash = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[alias]
	s = status -sb
	co = checkout
	sw = switch
	br = branch
	last = log -1 HEAD --stat
	unstage = restore --staged
	amend = commit --amend --no-edit
	lg = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	unmerged = log --oneline main..HEAD
