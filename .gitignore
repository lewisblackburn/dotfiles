# macOS
.DS_Store

# backups created by the link helper
*.bak
*.bak.*

# secrets — never commit auth tokens
config/gh/hosts.yml
config/zsh/.env

# nvim runtime/data (regenerated by lazy.nvim; only config is tracked)
config/nvim/.luarc.json.bak

# ssh: only config/ssh/config is tracked — never keys, sockets or local hosts
config/ssh/config.local
config/ssh/id_*
config/ssh/known_hosts*
config/ssh/sockets/
