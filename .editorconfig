# Shared editor settings. AstroNvim picks these up via the editorconfig support
# built into Neovim; VS Code needs the EditorConfig extension (it's in the
# registry's vscode rows).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.lua]
indent_size = 2

[*.{java,kt,kts}]
indent_size = 4

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{csv,tsv}]
trim_trailing_whitespace = false
