# Ghostty config. Reload with cmd+shift+,
# All options: ghostty +show-config --default --docs

# Theme and font
theme = Gruvbox Dark
font-family = JetBrains Mono
font-size = 14

# Window: frameless for square corners; tmux draws the tabs
window-decoration = none
window-show-tab-bar = never
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.95
background-blur = true
window-save-state = never
confirm-close-surface = false

# Always start inside tmux, so the cmd+t style shortcuts below always have a prefix to catch.
# Launched through a login zsh because Ghostty starts with the bare macOS PATH, which has no Nix tools.
# tmux itself runs zsh (default-shell in tmux.conf).
command = /bin/zsh -lc "exec tmux new -A -s main"

# Cursor (no-cursor stops the shell switching it to a bar)
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Mouse and clipboard
mouse-hide-while-typing = true
copy-on-select = clipboard

# Keyboard: left Option acts as Alt in nvim and the shell (macOS only)
macos-option-as-alt = left

# Drop-down terminal from any app (macOS asks for accessibility permission)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Ghostty's own tabs and windows are hidden behind tmux, so drop its default shortcuts
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind

# Mac shortcuts for tmux tabs: each sends ctrl+space (\x00, the prefix) and a key
keybind = cmd+t=text:\x00c
keybind = cmd+w=text:\x00x
keybind = cmd+d=text:\x00|
keybind = cmd+shift+d=text:\x00-
keybind = cmd+shift+left_bracket=text:\x00H
keybind = cmd+shift+right_bracket=text:\x00L
keybind = cmd+digit_1=text:\x001
keybind = cmd+digit_2=text:\x002
keybind = cmd+digit_3=text:\x003
keybind = cmd+digit_4=text:\x004
keybind = cmd+digit_5=text:\x005
keybind = cmd+digit_6=text:\x006
keybind = cmd+digit_7=text:\x007
keybind = cmd+digit_8=text:\x008
keybind = cmd+digit_9=text:\x009
