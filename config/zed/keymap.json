// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
	// Remove the default shortcuts so the `space f` chords are the only way
	// to open the file finder, project search and find/replace.
	{
		"context": "Workspace",
		"bindings": {
			"cmd-p": null,
			"cmd-shift-f": null,
			"cmd-shift-h": null,
		},
	},
	{
		"context": "VimControl && !menu",
		"bindings": {
			"g /": null,
		},
	},

	// `space f f` / `space f w` / `space f r` everywhere that isn't a text input.
	// (Not bound at Workspace level, otherwise typing a space in the
	// terminal or insert mode would wait for the rest of the chord.)
	{
		"context": "Editor && (vim_mode == normal || vim_mode == visual) && !menu",
		"bindings": {
			"space f f": "file_finder::Toggle",
			"space f w": "pane::DeploySearch",
			"space f r": ["pane::DeploySearch", { "replace_enabled": true }],
		},
	},
	{
		"context": "(ProjectPanel && not_editing) || (OutlinePanel && not_editing) || (GitPanel && ChangesList) || EmptyPane || SharedScreen || MarkdownPreview",
		"bindings": {
			"space f f": "file_finder::Toggle",
			"space f w": "pane::DeploySearch",
			"space f r": ["pane::DeploySearch", { "replace_enabled": true }],
		},
	},

	{
		"context": "Editor && vim_mode == insert",
		"bindings": {
			"j k": "vim::NormalBefore",
		},
	},
]
