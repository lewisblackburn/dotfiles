{
    // Appearance
    "workbench.colorTheme": "Dark 2026",
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.hidesExplorerArrows": true,
    "window.zoomLevel": 2,
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,

    // Layout
    "window.titleBarStyle": "native",
    "window.customTitleBarVisibility": "never",
    "workbench.activityBar.location": "hidden",
    "workbench.sideBar.location": "right",
    "workbench.statusBar.visible": false,
    "workbench.editor.showTabs": "single",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "editor.minimap.enabled": false,

    // Explorer
    "explorer.compactFolders": false,
    "workbench.tree.indent": 8,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.tree.enableStickyScroll": false,

    // Editing
    "editor.renderWhitespace": "trailing",
    "files.trimTrailingWhitespace": true,

    // Vim
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindingsNonRecursive": [
        { "before": ["j", "k"], "after": ["<Esc>"] }
    ],

    // Mise
    "mise.binPath": "~/dotfiles/bin/vscode-mise",
    "mise.configureExtensionsAutomatically": true,
    "mise.configureExtensionsIncludeGlobalTools": false,

    // Extensions
    "claudeCode.preferredLocation": "panel",
    "claudeCode.hideOnboarding": true,
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "redhat.telemetry.enabled": true
}
