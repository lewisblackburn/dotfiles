{
    "vim.leader": "<space>",
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "f", "f"],
            "commands": ["code-telescope.fuzzy.file"]
        },
        {
            "before": ["<leader>", "f", "w"],
            "commands": ["code-telescope.fuzzy.wsText"]
        }
    ],
    "mise.binPath": "~/dotfiles/bin/vscode-mise",
    "mise.configureExtensionsAutomatically": true,
    "mise.configureExtensionsIncludeGlobalTools": false,
    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "workbench.colorTheme": "Dark 2026",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
    },
    "redhat.telemetry.enabled": true,
    "intellij.region": "europe",
    "intellij.dataSharing": "none",
    "claudeCode.preferredLocation": "panel",
    "editor.fontSize": 14,
    "editor.formatOnSave": true,
}