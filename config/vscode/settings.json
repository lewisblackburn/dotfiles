{
    "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "${env:HOME}/.local/share/mise/installs/java/temurin-21",
            "default": true
        }
    ],
    "java.import.gradle.java.home": "${env:HOME}/.local/share/mise/installs/java/temurin-21",
    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "workbench.colorTheme": "Dark 2026"
}
